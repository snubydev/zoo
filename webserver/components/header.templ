package components

import "zoo/webserver/models"

templ header(data models.Data) {
    <div class="header bg-gray-800 py-1 text-white px-6 flex items-center">

    <div class="font-bold text-2xl py-1 pr-10 leading-tight">
        {data.HeaderTitle}
    </div>

    <div>
        @nav(data)
    </div>
    </div>
}
