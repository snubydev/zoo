package components

import (
    "zoo/webserver/models"
)

templ Layout(data models.Data, body templ.Component) {
    <!DOCTYPE html>
    <html lang="en">
    <head>
    <meta charset="UTF-8">
    <title>{ data.HeaderTitle }</title>
    <link href="static/output.css" rel="stylesheet">
    <link href="static/custom.css" rel="stylesheet">
    <script src="https://unpkg.com/htmx.org@1.9.4"></script>
    <script src="https://unpkg.com/hyperscript.org@0.9.7"></script>
    </head>
    <body>

    @header(data)

    <main id="content" class="container mx-auto md:w-2/3 lg:w-1/2">
        @body
    </main>

    </body>
    </html>
}
